{
  "capabilitiesAdd": [],
  "capabilitiesDrop": ["ALL"],
  "dockerSocketMounted": false,
  "hostIpc": false,
  "hostPid": false,
  "networkMode": "host",
  "noNewPrivileges": true,
  "privileged": false,
  "readOnlyRootfs": true,
  "restartPolicy": "no",
  "runtimeUser": "1000:1000",
  "schemaVersion": "codex-memory-native-container-policy/v1",
  "writableFilesystems": [
    { "destination": "/run/codex-memory-runtime", "kind": "tmpfs" },
    { "destination": "/tmp", "kind": "tmpfs" }
  ]
}
